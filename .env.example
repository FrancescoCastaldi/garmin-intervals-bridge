# DO NOT commit actual credentials or Garmin session tokens.
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0
BRIDGE_DATA_DIR=./data
GARMIN_TOKEN_DIR=./data/tokens
# your time zone, the day boundary (e.g. Europe/London); empty = this computer's, but a container has none
BRIDGE_TIMEZONE=
# sync windows (1-30 days); backfill takes explicit dates instead
BRIDGE_ACTIVITY_LOOKBACK_DAYS=4
BRIDGE_WELLNESS_LOOKBACK_DAYS=3
BRIDGE_WELLNESS_REFRESH_HOURS=4
# recommended (default) or all custom wellness fields, see docs/FIELD_MAPPING.md
BRIDGE_WELLNESS_PROFILE=recommended
# Seconds between Garmin requests; the endpoints are private, stay polite
BRIDGE_GARMIN_REQUEST_DELAY=0.5
# ImReady4 training advice into the TrainingAdvice wellness field each morning (docs/IMREADY4.md)
BRIDGE_IMREADY4_ENABLED=false
# experimental: advice from the 7-day HRV trend into its own field HRVTrendAdvice (docs/HRV_TREND.md)
BRIDGE_HRVTREND_ENABLED=false
# swap Garmin's filtered copy of each new activity for its original (deletes the copy; README: Modes)
BRIDGE_SWAP=false
# when the bridge needs you (Garmin sign-in, failing for a day): a push message (ntfy) and/or an e-mail
# BRIDGE_NTFY_URL=https://ntfy.sh/a-long-name-only-you-know
# BRIDGE_ALERT_EMAIL=you@gmail.com
# BRIDGE_SMTP_PASSWORD=app-password
